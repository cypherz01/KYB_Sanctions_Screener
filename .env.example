# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.

# Database (defaults match docker-compose)
DB_USER=kyb
DB_PASSWORD=kyb
# DB_PORT=5433                               where docker-compose publishes Postgres on this machine
# DB_URL=jdbc:postgresql://localhost:5433/kyb only for running the jar outside docker-compose
# KYB_PORT=8080                              where docker-compose publishes the service on this machine

# Companies House REST API key (free): https://developer.company-information.service.gov.uk
# Create a Live application, not a Test one: a Test key is refused by the real API with a 401.
COMPANIES_HOUSE_API_KEY=

# Sanctions import (OpenSanctions bulk data, no key needed). Optional overrides:
# KYB_SANCTIONS_IMPORT_CRON=0 30 3 * * *     nightly re-import (UK time); "-" disables it
# KYB_SANCTIONS_IMPORT_ON_STARTUP=true       set by docker-compose: first start loads the data
# KYB_MONITORING_CRON=*/15 * * * * *          how often the monitoring worker runs; "-" disables it
# KYB_MONITORING_RECHECK_INTERVAL=P30D        how often each monitored company is fully re-checked
# KYB_WEBHOOK_URL=                            where monitoring alerts are sent; unset means API only
# KYB_WEBHOOK_SECRET=                         signs each webhook; required if the URL is set

# FCA Register API (free): https://register.fca.org.uk/Developer/s/
# Without these the FCA factor is reported as unavailable; checks still run.
FCA_AUTH_EMAIL=
FCA_AUTH_KEY=

# Key callers send as the X-Api-Key header on /api/** (required: without it every API call is refused).
# Generate one, e.g.  openssl rand -hex 24
KYB_API_KEY=
