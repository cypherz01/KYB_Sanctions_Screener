# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.

# Database (defaults match docker-compose)
DB_USER=kyb
DB_PASSWORD=kyb

# Companies House REST API key (free): https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# Sanctions import (OpenSanctions bulk data, no key needed). Optional overrides:
# KYB_SANCTIONS_IMPORT_CRON=0 30 3 * * *     nightly re-import (UK time); "-" disables it
# KYB_SANCTIONS_IMPORT_ON_STARTUP=true       set by docker-compose: first start loads the data

# Added in later milestones:
# FCA_AUTH_EMAIL=            (M4) FCA Register API registration email
# FCA_AUTH_KEY=              (M4)
# KYB_API_KEY=               (M5) key callers send as X-Api-Key
